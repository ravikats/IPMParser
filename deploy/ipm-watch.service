[Unit]
Description=Mastercard IPM file watcher and validator
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ipm-watch
ExecStart=/opt/ipm-watch/venv/bin/python /opt/ipm-watch/watch_ipm.py \
    --watch /vp-switch/OUTPUT \
    --out /vp-switch/IPMLOGS \
    --prefix TESTR \
    --interval 5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
